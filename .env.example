# Copy to .env and fill in. NEVER commit the real .env.

# Required — Prisma/SQLite connection. Use a path that exists on your machine.
DATABASE_URL="file:./db/custom.db"

# App AI provider — Experiential Labs free quota (chat companion,
# summaries, RAG answers). Any OpenAI-compatible endpoint works; without
# a key the AI endpoints degrade gracefully and health reports the
# provider as down. Visitors may also bring their own key (BYOK).
AI_SITE_KEY=
AI_SITE_BASE_URL="https://api.experientiallabs.ai/v1"
AI_SITE_MODEL="deepseek-v4-flash"
AI_SITE_AUTH="bearer"
AI_SITE_NAME="experientiallabs"

# Legacy fallback (read only when the AI_SITE_* vars are unset):
# MIMO_API_KEY, MIMO_BASE_URL, MIMO_MODEL.

# Growth pipeline search only (optional, dormant). The scrape/auto-grow
# pipeline's web search still runs on Z.ai (src/lib/zai-api.ts); app AI
# generation does not use Z.ai anymore.
# ZAI_API_KEY=""

# Optional — Xiaomi MiMo pay-as-you-go track, used ONLY for the native
# web_search tool (Token Plan endpoints cannot web search). Needs the Web
# Search Plugin enabled in the MiMo console plus a funded balance.
# MIMO_PAYG_API_KEY=""
# MIMO_PAYG_BASE_URL="https://api.xiaomimimo.com/v1"
# MIMO_SEARCH_MODEL="mimo-v2.5"

# Semantic RAG embeddings (optional — keyword/FTS RAG works without this).
# Any OpenAI-compatible /embeddings endpoint. Ollama (local, free): pull nomic-embed-text.
EMBED_BASE_URL=""   # e.g. http://localhost:11434/v1
EMBED_MODEL=""      # e.g. nomic-embed-text | text-embedding-3-small
EMBED_API_KEY=""    # optional (Ollama/LM Studio need none)

# RAG answer generation fallback (optional). When the MiMo chat quota is exhausted,
# /api/rag POST automatically falls back to the local `kilo` CLI (@kilocode/cli),
# which is free (kilo/tencent/hy3:free, cost $0) — requires `kilo` on PATH and a
# logged-in kilo.ai session. No key needed here; only override if your setup differs.
# KILO_BIN="kilo"
# KILO_MODEL="kilo/tencent/hy3:free"

# Launch (optional). One switch that shows or hides all AI-facing UI.
# Off by default: the initial launch hides AI (chat, daily insight,
# summaries, scrape bar, grow database) while all AI/RAG code and API
# routes stay in place. Set to "true" to show AI UI.
# NEXT_PUBLIC_AI_ENABLED="false"

# AI abuse/cost guards (optional, defaults shown). Per-IP rate limit for
# AI-backed endpoints, and per-endpoint daily call budgets (in-memory;
# 0 or negative means unlimited).
# RATE_LIMIT_AI_RPM="20"
# AI_DAILY_CAP_CHAT="200"
# AI_DAILY_CAP_RAG="200"
# AI_DAILY_CAP_SUMMARIZE="100"

# Scrape pipeline (optional, dormant). The corpus is already in hand, so the
# scrape/auto-grow pipeline is OFF by default — the code stays in place but
# does nothing. Set to "true" to feed it again (enables POST /api/scrape,
# /api/auto-grow, and scripts/scrape-grow.mjs, scripts/crawl.mjs,
# scripts/eotc-grow.mjs).
# SCRAPE_ENABLED="false"
