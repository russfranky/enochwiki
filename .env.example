# Copy to .env and fill in. NEVER commit the real .env.

# Required — Prisma/SQLite connection. Use a path that exists on your machine.
DATABASE_URL="file:./db/custom.db"

# Optional — Z.ai API (AI study companion, web search, page reader, summarize).
# Without a key the app degrades gracefully to free fallbacks.
# Get one at https://z.ai/ — keep it secret, never hardcode it in source.
ZAI_API_KEY=""

# Optional overrides (defaults shown).
# ZAI_BASE_URL="https://api.z.ai/api/paas/v4"
# ZAI_MODEL="glm-4.5"

# Semantic RAG embeddings (optional — keyword/FTS RAG works without this).
# Any OpenAI-compatible /embeddings endpoint. Ollama (local, free): pull nomic-embed-text.
EMBED_BASE_URL=""   # e.g. http://localhost:11434/v1
EMBED_MODEL=""      # e.g. nomic-embed-text | text-embedding-3-small
EMBED_API_KEY=""    # optional (Ollama/LM Studio need none)

# RAG answer generation fallback (optional). When the Z.ai chat quota is exhausted,
# /api/rag POST automatically falls back to the local `kilo` CLI (@kilocode/cli),
# which is free (kilo/tencent/hy3:free, cost $0) — requires `kilo` on PATH and a
# logged-in kilo.ai session. No key needed here; only override if your setup differs.
# KILO_BIN="kilo"
# KILO_MODEL="kilo/tencent/hy3:free"

# Launch (optional). One switch that shows or hides all AI-facing UI.
# Off by default: the initial launch hides AI (chat, daily insight,
# summaries, scrape bar, grow database) while all AI/RAG code and API
# routes stay in place. Set to "true" to show AI UI later.
# No AI provider is chosen or wired at launch.
# NEXT_PUBLIC_AI_ENABLED="false"

# Scrape pipeline (optional, dormant). The corpus is already in hand, so the
# scrape/auto-grow pipeline is OFF by default — the code stays in place but
# does nothing. Set to "true" to feed it again (enables POST /api/scrape,
# /api/auto-grow, and scripts/scrape-grow.mjs, scripts/crawl.mjs,
# scripts/eotc-grow.mjs).
# SCRAPE_ENABLED="false"
